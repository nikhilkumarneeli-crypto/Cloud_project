# AWS Environment Configuration (Template only - Never commit real keys)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# API Gateway Endpoint (populated after CDK deployment or using local mock server)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_AWS_REGION=us-east-1

# Amazon Cognito Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_exampleId
VITE_COGNITO_CLIENT_ID=exampleclientid123456789
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:00000000-0000-0000-0000-000000000000

# Feature Flags
VITE_USE_LOCAL_MOCK_API=true
VITE_SIMULATE_PAYMENTS=true

# Learner Lab IAM Role (Default LabRole provided by AWS Academy)
CDK_DEFAULT_LAB_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole
